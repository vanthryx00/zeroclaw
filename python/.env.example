# PhantomSwarm — Environment Configuration Template
# Copy to .env and fill in your values. NEVER commit .env to git.

# Your operator identity — embedded in every mission watermark
PHANTOM_OPERATOR=OPERATOR

# HMAC key for watermark signing
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
PHANTOM_SECRET=change-this-to-a-long-random-secret-string

# Database path (swarm + graph share this file, or set separate paths)
PHANTOM_DB=./phantom_swarm.db
