# OmniMind Revenue Engine — environment variables
# Copy to .env and fill in your values.

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use sk_test_... for testing, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...

# Optional: paste price IDs from your Stripe dashboard
# If blank, prices are created on-the-fly (works but creates duplicates over time)
STRIPE_PRICE_SETUP=
STRIPE_PRICE_MONTHLY=

# Stripe webhook secret (for /api/billing/webhook endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── SMTP (for invoice emails) ─────────────────────────────────────────────────
# Gmail: enable 2FA → Google account → Security → App passwords → generate one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=OmniMind Security <you@gmail.com>

# ── Database ─────────────────────────────────────────────────────────────────
OMNIMIND_DB=./omnimind_warfare.db
